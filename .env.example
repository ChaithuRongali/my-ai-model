# ===============================================================
# My AI - ENVIRONMENT VARIABLE TEMPLATE
# ---------------------------------------------------------------
# 1. Make a copy of this file and name the copy: .env
# 2. Open .env and replace your_api_key_here with your real key.
# 3. NEVER commit .env, and never share your key with anyone.
# ===============================================================

# Your secret OpenAI API key (get it from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_api_key_here

# Optional: OpenAI-compatible endpoint. Leave blank to use api.openai.com.
# For free Groq: https://api.groq.com/openai/v1
# For Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=

# The AI model to use by default.
# OpenAI: gpt-4o-mini | Groq: openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini

# The assistant's personality / instructions.
SYSTEM_PROMPT=You are My AI, a friendly, helpful and intelligent AI assistant. Explain concepts clearly, provide accurate information, and help users solve problems.

# Browser addresses allowed to call this API (comma-separated, no spaces).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
